# Database connection
# Default for zero-config local sandbox development:
DATABASE_URL="file:./dev.db"

# For production deployment with PostgreSQL (e.g. Neon, Supabase, AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/subscriptiq?sslmode=require"

# Authentication secret for JWT tokens / session cookies
JWT_SECRET="subscriptiq_super_secret_jwt_key_at_least_32_chars_long_2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Mode
NODE_ENV="development"

